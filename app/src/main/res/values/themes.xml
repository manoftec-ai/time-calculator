<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. -->
    <style name="Theme.TimeCalc" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/md_theme_primary</item>
        <item name="colorPrimaryVariant">@color/md_theme_secondary</item>
        <item name="colorOnPrimary">@color/md_theme_onPrimary</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/md_theme_secondary</item>
        <item name="colorSecondaryVariant">@color/md_theme_onSecondary</item>
        <item name="colorOnSecondary">@color/md_theme_onSecondary</item>
        <!-- Status bar and background. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:colorBackground">@color/md_theme_surface</item>
        <item name="android:textColorPrimary">@color/md_theme_onSurface</item>
    </style>
</resources>
